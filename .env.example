# ===== Flask =====
# Required, and has no default: a key committed to the repo would be a known
# value in every deployment that did not override it. Generate one with
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# LLM API configuration (any LLM API that speaks the OpenAI SDK format)
# Recommended: Alibaba Bailian qwen-plus - https://bailian.console.aliyun.com/
# Note: token usage is heavy; start with a simulation of fewer than 40 rounds
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# --- Local / self-hosted server instead (LM Studio, Ollama, vLLM, llama.cpp) ---
# Point LLM_BASE_URL at the machine running it and LLM_API_KEY becomes optional.
# LM Studio: start the server (Developer tab), enable "Serve on Local Network"
# to reach it from another machine, then use its host and port:
#   LLM_BASE_URL=http://localhost:1234/v1     # same machine
#   LLM_BASE_URL=http://192.168.1.10:1234/v1  # another machine on the LAN
#   LLM_MODEL_NAME=qwen2.5-7b-instruct        # the model id shown in LM Studio
# Only loopback, private-range IPs, and *.local hosts skip the key requirement.
# Ollama uses port 11434 (http://localhost:11434/v1).

# ===== Chatbot LLM configuration (optional) =====
# The workspace follow-up chat. Interactive, so a faster or cheaper model than
# the one the agents run on is usually the right trade. Each entry falls back
# to its LLM_* counterpart above when left out.
# The key is inherited only when CHATBOT_LLM_BASE_URL matches LLM_BASE_URL. Mix
# a local chatbot with cloud agents (or the reverse) and each side needs its own
# key - a local base URL supplies its own, a cloud one you must set here.
#   CHATBOT_LLM_BASE_URL=http://localhost:1234/v1   # chat on LM Studio,
#   CHATBOT_LLM_MODEL_NAME=qwen2.5-7b-instruct      # agents still on the cloud
CHATBOT_LLM_API_KEY=your_api_key_here
CHATBOT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHATBOT_LLM_MODEL_NAME=qwen-flash

# ===== Content vector index (optional) =====
# Gives the chatbot semantic search over the posts and comments the simulated
# audience actually wrote, instead of only the knowledge-graph summaries.
# Embeddings use the OpenAI format and inherit LLM_* when left out.
#   EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   EMBEDDING_MODEL_NAME=text-embedding-v4     # OpenAI: text-embedding-3-small
#   EMBEDDING_API_KEY=your_api_key_here        # needed only if the endpoint differs
# Qdrant runs embedded (backend/uploads/qdrant) with no server. Set QDRANT_URL
# to use a real instance - required if you run more than one worker process.
#   QDRANT_URL=http://localhost:6333
#   QDRANT_API_KEY=

# ===== ZEP memory graph configuration =====
# The monthly free tier is enough for light usage: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Boost LLM configuration (optional) =====
# If you are not using the boost config, leave the entries below out of your .env entirely
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== Public-discussion corpus (optional) =====
# Grounds the audience personas in real category discussion instead of
# LLM-invented demographics. Reddit's official API is the only source.
#
# Only the secrets live here. Which crawlers run, and how politely, is in
# config/corpus.yml - switch a source off there.
#
# Reddit - free "script" app at https://www.reddit.com/prefs/apps
# Without these two keys the corpus harvests nothing.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
#
# Author handles are hashed with this salt and never stored raw.
# Set it to any random string; changing it rotates every pseudonym.
CORPUS_AUTHOR_SALT=change-me
